Net Sales =
SUM(ReportFinance[NetSales])

COGS =
SUM(ReportFinance[COGS])

Gross Profit =
[Net Sales] - [COGS]

Gross Margin % =
DIVIDE([Gross Profit], [Net Sales])

Sales Budget =
SUM(ReportFinance[SalesBudget])

Budget Variance =
[Net Sales] - [Sales Budget]

Budget Variance % =
DIVIDE([Budget Variance], [Sales Budget])

Previous Period Sales =
CALCULATE([Net Sales], DATEADD(DimDate[Date], -1, MONTH))

Sales Growth % =
DIVIDE([Net Sales] - [Previous Period Sales], [Previous Period Sales])

Units Sold =
SUM(ReportFinance[UnitsSold])

Return Rate =
DIVIDE(SUM(ReportFinance[UnitsReturned]), [Units Sold])

Average Order Value =
DIVIDE([Net Sales], SUM(ReportFinance[FulfilledOrders]))

Current Inventory Value =
SUM(ReportInventory[InventoryValue])

Stockout Risk Count =
SUM(ReportInventory[StockoutRisk])

Units On Hand =
SUM(ReportInventory[UnitsOnHand])

Integration Success Rate =
DIVIDE(SUM(ReportSystems[SuccessfulEvents]), SUM(ReportSystems[AttemptedEvents]))

Failed Integration Events =
SUM(ReportSystems[FailedEvents])

SLA Compliance Rate =
DIVIDE(SUM(ReportSystems[SLAMet]), SUM(ReportSystems[SLAEligible]))

Mean Time to Resolution =
DIVIDE(SUM(ReportSystems[ResolutionHours]), SUM(ReportSystems[ResolvedTickets]))

Orders Awaiting Reconciliation =
CALCULATE(COUNTROWS(ReportReconciliation), ReportReconciliation[SyncStatus] = "Awaiting reconciliation")

Pending Purchase Orders =
CALCULATE(COUNTROWS(ReportPurchasing), ReportPurchasing[POStatus] <> "Received")
